[Unit]
Description=HA ANT+ Remote Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ha-antplus-gateway.env
ExecStart=/opt/ha-antplus-gateway/venv/bin/python /opt/ha-antplus-gateway/antplus_gateway.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
